# Copy to .env.demo and adjust the directories for your machine.
VOXCPM_MODELS_DIR=/path/to/voxcpm-studio/models
VOXCPM_LORA_DIR=/path/to/voxcpm-studio/lora
VOXCPM_DATA_DIR=/path/to/voxcpm-studio/demo-data

# Runtime device selection: auto, cuda, cuda:0, mps, cpu
VOXCPM_DEVICE=auto

# Training precision: auto, fp32, or amp
VOXCPM_TRAIN_PRECISION=auto

# SenseVoice device selection: auto, cuda:0, mps, cpu
SENSEVOICE_DEVICE=auto

# docker-cuda, native-cuda, native-mps, native-cpu
DEMO_RUN_MODE=native-cpu

DEMO_API_HOST=0.0.0.0
DEMO_API_PORT=8000
DEMO_WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
